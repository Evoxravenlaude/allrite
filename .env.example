# Copy this file to .env.local and fill in the values.
# With nothing filled in, the site runs in demo mode on your computer: sample products, simulated payments, no emails.
# On Vercel, set DEMO_MODE=1 for a preview without a database. Remove it once DATABASE_URL is set.
DEMO_MODE=

# Public address of the website, without a trailing slash
SITE_URL=https://www.allrite.example

# Long random text that protects sign-ins. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Supabase: Project settings > Database > Connection string (Transaction pooler, port 6543)
DATABASE_URL=
# Supabase: Project settings > API. Used only to store product photos in the "products" bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The first owner account, created by "npm run db:setup"
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Paystack: Settings > API Keys and Webhooks. Use the test key first, then the live key at launch.
PAYSTACK_SECRET_KEY=

# Resend (resend.com) for order confirmations and receipts. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Allrite <orders@allrite.example>
# Where viewing requests are sent. Defaults to the store email in the dashboard.
STORE_NOTIFY_EMAIL=
